        RowBox[{"k", "=", "0"}], "Nmax"], 
       RowBox[{"\[Theta]", "*", 
        RowBox[{"a\[Alpha]\[Beta]d", "[", "k", "]"}]}]}], ")"}]}]}], ";"}], 
