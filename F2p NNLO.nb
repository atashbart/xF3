 RowBox[{
  RowBox[{"Nmax", "=", "9"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Beta]", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]", "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox[
       RowBox[{"  ", 
        RowBox[{
         RowBox[{"k", "!"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "  ", "k"}], "+", "\[Alpha]", "+", "\[Beta]", "+", 
           "1"}], ")"}], " ", 
         RowBox[{"Gamma", "[", 
          RowBox[{"k", "+", "\[Alpha]", "+", "\[Beta]", "+", "1"}], "]"}]}]}], 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"k", "+", "\[Alpha]", "+", "1"}], "]"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"k", "+", "\[Beta]", "+", "1"}], "]"}]}]], "  "}]], 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "k"], 
     RowBox[{
      RowBox[{"k", "!"}], 
      SuperscriptBox["x", "\[Beta]"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}], "\[Alpha]"]}]], 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "k"}], "}"}]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", 
        RowBox[{"\[Beta]", "+", "k"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}], 
        RowBox[{"\[Alpha]", "+", "k"}]]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ckj", "=", 
    RowBox[{
     SqrtBox[
      RowBox[{
       FractionBox[
        RowBox[{" ", 
         RowBox[{
          RowBox[{"k", "!"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "k"}], "+", "\[Alpha]", "+", "\[Beta]", "+", 
            "1"}], ")"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{"k", "+", "\[Alpha]", "+", "\[Beta]", "+", "1"}], 
           "]"}]}]}], 
        RowBox[{
         RowBox[{"Gamma", "[", 
          RowBox[{"k", "+", "\[Alpha]", "+", "1"}], "]"}], 
         RowBox[{"Gamma", "[", 
          RowBox[{"k", "+", "\[Beta]", "+", "1"}], "]"}]}]], "  "}]], 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "k"], 
      RowBox[{"k", "!"}]], 
     FractionBox["1", 
      RowBox[{"j", "!"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Pochhammer", "[", 
        RowBox[{
         RowBox[{"-", "k"}], ",", "j"}], "]"}], 
       RowBox[{"Pochhammer", "[", 
        RowBox[{
         RowBox[{"\[Alpha]", "+", "\[Beta]", "+", "k", "+", "1"}], ",", "j"}],
         "]"}], 
       RowBox[{"Pochhammer", "[", 
        RowBox[{
         RowBox[{"\[Beta]", "+", "j", "+", "1"}], ",", 
         RowBox[{"k", "-", "j"}]}], "]"}]}], ")"}]}]}], ";", 
