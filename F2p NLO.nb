 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"M2", "[", 
     RowBox[{"s_", ",", "Q_"}], "]"}], ":=", "F2p"}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"M2TMC", "[", 
    RowBox[{"s_", ",", "Q_", ",", "mN_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"M2", "[", 
     RowBox[{"s", ",", "Q"}], "]"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"s", "*", 
        RowBox[{"(", 
         RowBox[{"s", "-", "1"}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"s", "+", "2"}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mN", "^", "2"}], "/", "Q"}], ")"}], "^", "1"}], "*", 
     RowBox[{"M2", "[", 
      RowBox[{
       RowBox[{"s", "+", "2"}], ",", "Q"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"s", "+", "3"}], "]"}], "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", 
         RowBox[{"Gamma", "[", 
          RowBox[{"s", "-", "1"}], "]"}], "*", 
         RowBox[{"Gamma", "[", 
          RowBox[{"s", "+", "5"}], "]"}]}], ")"}]}], ")"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mN", "^", "2"}], "/", "Q"}], ")"}], "^", "2"}], "*", 
     RowBox[{"M2", "[", 
      RowBox[{
       RowBox[{"s", "+", "4"}], ",", "Q"}], "]"}]}]}]}], ";"}]}], "Input",
