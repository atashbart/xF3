       RowBox[{"s", "+", "2"}], ",", "Q"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{"s", "+", "3"}], "]"}], "^", "2"}], "/", 
       RowBox[{"(", 
