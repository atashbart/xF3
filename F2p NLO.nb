  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"M2TMCd", "[", 
    RowBox[{"s_", ",", "Q_", ",", "mNd_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"M2d", "[", 
     RowBox[{"s", ",", "Q"}], "]"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"s", "*", 
        RowBox[{"(", 
